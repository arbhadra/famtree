# Copy to .env.local to enable accounts and cloud save locally.
# Both values are in Supabase → Project Settings → API. The anon key is safe to expose:
# row-level security in supabase/migrations decides what each user can read and write.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
